SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-high-privilege-service-role-key-bypasses-rls
INTERNAL_SECRET_TOKEN=secure_cryptographically_strong_random_string_matches_edge_function
PORT=8080

# --- Optional: DeepSeek fallback for messages the regex parser cannot read ---
# Leave DEEPSEEK_API_KEY empty to keep it off. If it is set, the next four are ALL required
# (the worker refuses to start otherwise). Check current model names and prices at
# https://api-docs.deepseek.com/quick_start/pricing because they change. The values below are examples only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Use the highest price (peak hours, cache miss) so the charge never undershoots. USD per 1M tokens.
DEEPSEEK_INPUT_USD_PER_M=0.44
DEEPSEEK_OUTPUT_USD_PER_M=1.32
# How many credits you charge a client per 1 USD of AI cost. This is your markup lever.
CREDITS_PER_USD=1000
# Optional: max AI calls per minute for the whole worker (default 120).
# DEEPSEEK_MAX_CALLS_PER_MINUTE=120

